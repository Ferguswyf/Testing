  77:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_gpio.h ****  * \if XMC1
  78:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_gpio.h ****  * -# Allows the selection of input hysteresis. XMC_GPIO_SetInputHysteresis()
  79:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_gpio.h ****  * \endif
  80:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_gpio.h ****  *
  81:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_gpio.h ****  * 
