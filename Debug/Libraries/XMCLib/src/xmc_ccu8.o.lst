1876:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h ****  * @return <BR>
1877:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h ****  *    None<BR>
1878:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h ****  *
1879:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h ****  * \par<b>Description:</b><br>
1880:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h ****  * Disables the floating prescaler, by clearing CC8yTC.FPE bit.\n\n
1881:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h ****  * This would return the prescaler to the normal mode.
1882:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h ****  * The prescaler that would be applied is the value present in CC8yPSC.
1883:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h ****  *
1884:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h ****   * \par<b>Related APIs:</b><br>
1885:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h ****  *  XMC_CCU8_SLICE_EnableFloatingPrescaler().
1886:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h ****  */
1887:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h **** __STATIC_INLINE void XMC_CCU8_SLICE_DisableFloatingPrescaler(XMC_CCU8_SLICE_t *const slice)
1888:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h **** {
1889:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h ****   XMC_ASSERT("XMC_CCU8_SLICE_DisableFloatingPrescaler:Invalid Slice Pointer", XMC_CCU8_CHECK_SLICE_
1890:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h ****   slice->TC &= ~((uint32_t) CCU8_CC8_TC_FPE_Msk);
1891:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h **** }
1892:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h **** 
1893:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h **** /**
1894:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h ****  * @param slice Constant pointer to CC8 Slice
1895:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h ****  * @param comp_val Dither compare value
1896:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h ****  *                 Range: [0x0 to 0xF]
1897:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h ****  * @return <BR>
1898:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h ****  *    None<BR>
1899:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h ****  *
1900:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h ****  * \par<b>Description:</b><br>
1901:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h ****  * Sets the dither spread/compare value, by setting CC8yDITS.DCVS bits.\n\n
1902:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h ****  * This value is the cornerstone of PWM dithering feature. Dithering is applied/done when the value
1903:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h ****  * dithering counter is less than this compare/spread value. For all dithering counter values great
1904:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h ****  * the spread value, there is no dithering. After setting the value XMC_CCU8_EnableShadowTransfer()
1905:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h ****  * called with appropriate mask.
1906:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h ****  *
1907:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h ****   * \par<b>Related APIs:</b><br>
1908:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h ****  *  XMC_CCU8_SLICE_EnableDithering().
1909:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu8.h ****  */
