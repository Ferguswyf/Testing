  73:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** /**
  74:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * @addtogroup XMClib
  75:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * @{
  76:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  */
  77:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** 
  78:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** /**
  79:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * @addtogroup POSIF
  80:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * @{
  81:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * @brief Position Interface Unit (POSIF) driver for the XMC microcontroller family <br>
  82:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  *
  83:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * The POSIF unit is a flexible and powerful component for motor control systems that use
  84:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * rotary encoders or hall sensors as feedback loop. It provides interface for motor position and v
  85:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * POSIF unit works with CCU4 and CCU8 to enable position and velocity measurement and to control P
  86:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  *
  87:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * Driver is divided in three POSIF functional blocks - Hall Sensor Control (POSIF_HSC), Quadrature
  88:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * MultiChannel Mode (POSIF_MCM). <br>
  89:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  *
  90:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * POSIF driver features:
  91:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * -#  Configuration structure XMC_POSIF_CONFIG_t and initialization function XMC_POSIF_Init() to c
  92:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * -# Allows to change the operating mode using XMC_POSIF_SetMode()
  93:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * -# Allows the selection of one of the four inputs (A, B, C or D) using XMC_POSIF_SelectInputSour
  94:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * hall0, hall1 and hall2 signals. For quadrature decoder mode, inputs are phase A, phase B and ind
  95:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * -#  Hall Sensor Control (APIs prefixed with XMC_POSIF_HSC_) <br>
  96:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * 	-  Configuration structure XMC_POSIF_HSC_CONFIG_t and initialization function XMC_POSIF_HSC_Ini
  97:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * 	-  Update current and expected hall pattern in shadow register using XMC_POSIF_HSC_SetHallPatte
  98:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * 	- Allows immediate shadow transfer using XMC_POSIF_HSC_UpdateHallPattern()
  99:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * -#  Quadrature Decoder (APIs prefixed with XMC_POSIF_QD_) <br>
 100:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * 	-  Configuration structure XMC_POSIF_QD_CONFIG_t and initialization function XMC_POSIF_QD_Init(
 101:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * 	-  Get direction of rotation using XMC_POSIF_QD_GetDirection()
 102:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * -#  MultiChannel Mode (APIs prefixed with XMC_POSIF_MCM_) <br>
 103:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  *	-  Configuration structure XMC_POSIF_MCM_CONFIG_t and initialization function XMC_POSIF_MCM_Init
 104:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  *	-  Update multichannel pattern in shadow register using XMC_POSIF_MCM_SetMultiChannelPattern()
 105:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  *	-  Allows immediate shadow transfer using XMC_POSIF_MCM_UpdateMultiChannelPattern()
 106:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * -# User need to call respective init functions to configure POSIF operating mode. e.g to configu
 107:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * call both XMC_POSIF_HSC_Init() and XMC_POSIF_MCM_Init().
 108:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * -# Allows to enable and disable interrupt sources and assign to service request node using XMC_P
 109:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** 
 110:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  */
 111:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** /* POSIF is not available on XMC11 and XMC12 devices */
 112:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** 
 113:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** /**************************************************************************************************
 114:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * MACROS
 115:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  **************************************************************************************************
 116:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** #define XMC_POSIF_PCONF_INSEL_Msk        (0x3fUL << POSIF_PCONF_INSEL0_Pos) /*< Mask for input pins
 117:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** #define XMC_POSIF_INSEL_MAX              (4U) /*< Maximum possible input selector */
 118:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** #define XMC_POSIF_HALPS_HALLPAT_Msk      (0x3FUL)
 119:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** 
 120:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** #if ((UC_SERIES == XMC45) || (UC_SERIES == XMC44))
 121:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** #define XMC_POSIF_CHECK_MODULE_PTR(PTR)  ( ((PTR)== POSIF0) || ((PTR)== POSIF1) ) /*< Check for val
 122:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** #else
 123:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** #define XMC_POSIF_CHECK_MODULE_PTR(PTR)  ( ((PTR)== POSIF0))  /*< Check for valid module pointer */
 124:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** #endif
 125:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** 
 126:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** /**************************************************************************************************
 127:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * ENUMS
 128:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  **************************************************************************************************
 129:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** /**
 130:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  *  Defines the return status, to verify the POSIF related API calls. Use type @ref XMC_POSIF_STATU
 131:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  */
 132:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** typedef enum XMC_POSIF_STATUS
 133:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** {
 134:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****   XMC_POSIF_STATUS_OK = 0U,     /**< API fulfills request */
 135:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****   XMC_POSIF_STATUS_ERROR        /**< API cannot fulfill request */
 136:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** } XMC_POSIF_STATUS_t;
 137:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** 
 138:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** /**
 139:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * Defines POSIF configurable modes.Use type @ref XMC_POSIF_MODE_t for this enum.
 140:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * The members defines the function selector(FSEL) bitfields of \a PCONF register.
 141:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  */
 142:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** typedef enum XMC_POSIF_MODE
 143:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** {
 144:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****   XMC_POSIF_MODE_HALL_SENSOR = 0U, /**< Hall sensor mode */
 145:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****   XMC_POSIF_MODE_QD              , /**< Quadrature Decoder mode */
 146:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****   XMC_POSIF_MODE_MCM             , /**< Standalone Multichannel mode */
 147:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****   XMC_POSIF_MODE_MCM_QD           /**< Quadrature Decoder + Standalone Multichannel mode */
 148:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** } XMC_POSIF_MODE_t;
 149:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** 
 150:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** /**
 151:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * Defines POSIF configurable input ports.Use type @ref XMC_POSIF_INPUT_PORT_t for this enum.
 152:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * The member defines the respective input selector(INSELX) bitfields of \a PCONF register.
 153:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * It selects, which input is used for the phase or Hall input function (depending on the module is
 154:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * Quadrature Decoder or Hall Sensor Mode). Same enum can be used to configure pattern update signa
 155:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  * \a PCONF register's \a MSETS bit field.
 156:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****  */
 157:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** typedef enum XMC_POSIF_INPUT_PORT
 158:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h **** {
 159:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****   XMC_POSIF_INPUT_PORT_A = 0U, /**< INPUT-A */
 160:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_posif.h ****   XMC_POSIF_INPUT_PORT_B     , /**< INPUT-B */
