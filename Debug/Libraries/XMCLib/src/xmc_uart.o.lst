1385:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****                                                    const uint32_t event)
1386:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h **** {
1387:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****   channel->TRBSCR |= event;
1388:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h **** }
