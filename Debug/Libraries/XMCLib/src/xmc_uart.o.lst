  62:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * @addtogroup XMClib XMC Peripheral Library
  63:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * @{
