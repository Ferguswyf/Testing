 312:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h **** 
 313:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h **** /**
 314:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * @param channel Constant pointer to USIC channel handle of type @ref XMC_USIC_CH_t \n
 315:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * 				  \b Range: @ref XMC_USIC0_CH0, @ref XMC_USIC0_CH1 to @ref XMC_USIC2_CH1 based on device sup
 316:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * @param  data Data to be transmitted. \n 
 317:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  *          \b Range: 16 bit unsigned data within the range 0 to 65535. Actual size of
 318:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  *          data transmitted depends on the configured number of bits for the UART protocol in the 
 319:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * @return None
 320:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  *
 321:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * \par<b>Description</b><br>
 322:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * Transmits data over serial communication channel using UART protocol.\n\n
 323:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * Based on the channel configuration, data is either put to the transmit FIFO or to TBUF register.
 324:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * Before putting data to TBUF, the API waits for TBUF to finish shifting its contents to shift reg
 325:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * So user can continuously execute the API without checking for TBUF busy status. Based on the num
 326:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * data bits configured, the lower significant bits will be extracted for transmission.
 327:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  *
 328:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * Note: When FIFO is not configured, the API waits for the TBUF to be available. 
 329:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * This makes the execution a blocking call.
 330:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  *
 331:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * \par<b>Related APIs:</b><BR>
 332:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * XMC_UART_CH_GetReceivedData() \n\n\n
 333:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  */
 334:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h **** void XMC_UART_CH_Transmit(XMC_USIC_CH_t *const channel, const uint16_t data);
 335:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h **** 
 336:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h **** /**
 337:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * @param channel Constant pointer to USIC channel handle of type @ref XMC_USIC_CH_t \n
 338:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * 				  \b Range: @ref XMC_USIC0_CH0, @ref XMC_USIC0_CH1 to @ref XMC_USIC2_CH1 based on device sup
 339:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * @return uint16_t Received data over UART communication channel.
 340:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * \par<b>Description</b><br>
 341:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * Provides one word of data received over UART communication channel.\n\n
 342:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * Based on the channel configuration, data is either read from the receive FIFO or RBUF register.
 343:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * Before returning the value, there is no check for data validity. User should check the appropria
 344:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * data receive flags(standard receive/alternative receive/FIFO standard receive/FIFO alternative r
 345:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * before executing the API. Reading from an empty receive FIFO can generate a receive error event.
 346:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  *
 347:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * \par<b>Related APIs:</b><BR>
 348:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * XMC_UART_CH_GetStatusFlag(), XMC_UART_CH_Transmit() \n\n\n
 349:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  */
 350:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h **** uint16_t XMC_UART_CH_GetReceivedData(XMC_USIC_CH_t *const channel);
 351:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h **** 
 352:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h **** /**
 353:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * @param  channel Constant pointer to USIC channel handle of type @ref XMC_USIC_CH_t \n
 354:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * 				  \b Range: @ref XMC_USIC0_CH0, @ref XMC_USIC0_CH1 to @ref XMC_USIC2_CH1 based on device sup
 355:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * @param  word_length Data word length. \n
 356:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  *          \b Range: minimum= 1, maximum= 16.
 357:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * @return None
 358:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  *
 359:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * \par<b>Description</b><br>
 360:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * Sets the data word length in number of bits.\n\n
 361:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * Word length can range from 1 to 16. It indicates the number of data bits in a data word.
 362:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * The value of \a word_length will be decremented by 1 before setting the value to \a SCTR registe
 363:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * If the UART data bits is more than 16, then the frame length should be set to the actual number 
 364:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * word length should be configured with the number of bits expected in each transaction. For examp
 365:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * for UART communication is 20 bits, then the frame length should be set as 20. Word length can be
 366:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * transmit and receive handling. If data is stored as 8bit array, then the word length can be set 
 367:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * a full message of UART data should be transmitted/ received as 3 data words.
 368:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  *
 369:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * \par<b>Related APIs:</b><BR>
 370:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * XMC_UART_CH_SetFrameLength() \n\n\n
 371:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  */
 372:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h **** __STATIC_INLINE void XMC_UART_CH_SetWordLength(XMC_USIC_CH_t *const channel, const uint8_t word_len
 373:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h **** {
 374:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****   XMC_USIC_CH_SetWordLength(channel, word_length);
 375:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h **** }
 376:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h **** 
 377:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h **** /**
 378:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * @param  channel Constant pointer to USIC channel handle of type @ref XMC_USIC_CH_t \n
 379:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * 				  \b Range: @ref XMC_USIC0_CH0, @ref XMC_USIC0_CH1 to @ref XMC_USIC2_CH1 based on device sup
 380:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * @param  frame_length Number of data bits in each UART frame. \n
 381:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  *          \b Range: minimum= 1, maximum= 64.
 382:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * @return None
 383:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  *
 384:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * \par<b>Description</b><br>
 385:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * Sets the number of data bits for UART communication.\n\n
 386:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * The frame length is configured by setting the input value to \a SCTR register.
 387:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * The value of \a frame_length will be decremented by 1, before setting it to the register.
 388:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * Frame length should not be set to 64 for UART communication.
 389:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  *
 390:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * \par<b>Related APIs:</b><BR>
 391:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * XMC_UART_CH_SetWordLength() \n\n\n
 392:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  */
 393:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h **** __STATIC_INLINE void XMC_UART_CH_SetFrameLength(XMC_USIC_CH_t *const channel, const uint8_t frame_l
 394:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h **** {
 395:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****   XMC_USIC_CH_SetFrameLength(channel, frame_length);
 396:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h **** }
 397:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h **** 
