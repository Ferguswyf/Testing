 271:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h **** /**
 272:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * @param channel Constant pointer to USIC channel handle of type @ref XMC_USIC_CH_t \n
 273:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * 				  \b Range: @ref XMC_USIC0_CH0, @ref XMC_USIC0_CH1 to @ref XMC_USIC2_CH1 based on device sup
 274:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * @return XMC_UART_CH_STATUS_t Status to indicate if the communication channel is stopped successf
 275:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  *                              @ref XMC_UART_CH_STATUS_OK if the communication channel is stopped.
 276:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  *                              @ref XMC_UART_CH_STATUS_BUSY if the communication channel is busy.
 277:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  *
 278:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * \par<b>Description</b><br>
 279:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * Stops the UART communication.\n\n
 280:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * CCR register bitfield \a Mode is reset. This disables the communication.
 281:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  * Before starting the communication again, the channel has to be reconfigured.
 282:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_uart.h ****  *
