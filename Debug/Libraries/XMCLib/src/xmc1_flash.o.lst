 133:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * \if XMC1
 134:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * Informs the status of flash by reading the NVMSTATUS register.\n\n  It indicates the ECC, VERR(v
 135:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * WRPERR (Write protocol error) errors as well as the current flash state. After calling the flash
 136:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * operation related APIs, call this API to get the verification status. The return value of this A
 137:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * against the members of @ref XMC_FLASH_STATUS_t enumeration to get the relevant status.
 138:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * \endif
 139:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * \if XMC4
 140:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * Informs the status of flash by reading the FSR register.\n\n  It indicates the error status such
 141:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * PROER, PFDBER, ORIER, VER errors as well as the current flash state. After calling the flash rea
 142:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * operation related APIs, call this API to verify flash status. The return value of this API shall
 143:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * the members of @ref XMC_FLASH_STATUS_t enumeration to get the relevant status.
 144:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * \endif
