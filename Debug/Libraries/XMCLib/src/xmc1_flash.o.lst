 182:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h **** /**
 183:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  *
 184:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * @param address    Pointer to the starting address of flash page from where the programming start
 185:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * @param data       Pointer to the source address where targeted data is located.
 186:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  *
 187:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * @return None
 188:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  *
 189:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * \par<b>Description:</b><br>
 190:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * \if XMC1
 191:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * Programs a single flash page associated with the specified \a address.\n\n XMC1000 Flash can be 
 192:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * page (256 bytes) using this API. It calls the Flash Firmware routine \a XMC1000_NvmProgVerify(un
 193:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * to perform the programming. Refer XMC1000 reference manual of for more details on flash firmware
 194:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * (Section 25.3). Call XMC_FLASH_GetStatus() API after calling this API, to verify the erase opera
 195:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * \endif
 196:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * \if XMC4
 197:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * Programs a single flash page associated with the specified \a address.\n\n  XMC4000 flash can be
 198:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * granularity of 256 bytes page using this API. Before entering into page write process, it clears
 199:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * bits inside status register. It starts the write process by issuing the page mode command follow
 200:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * command which loads the targeted \a data blocks into internal assembly buffer. Finally, it issue
 201:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * command which programs the \a data into flash. Call XMC_FLASH_GetStatus() API after calling this
 202:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * erase operation.\n
 203:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * \endif
 204:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  *
 205:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * \par<b>Note:</b><br>
 206:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * Flash will be busy state during write is ongoing, hence no operations allowed until it completes
 207:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  *
 208:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * \par<b>Related APIs:</b><BR>
 209:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * None 
 210:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  *
 211:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  */
 212:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h **** void XMC_FLASH_ProgramPage(uint32_t *address, const uint32_t *data);
 213:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h **** 
 214:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h **** /**
 215:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  *
 216:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * @param address Pointer to the starting address of the page to be erased.
 217:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  *
 218:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * @return None
 219:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  *
 220:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * \par<b>Description:</b><br>
 221:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * \if XMC1
 222:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * Erases a complete sector starting from the \a address specified.\n\n  XMC1000 Flash can be erase
 223:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * of one page = 16 blocks of 16 Bytes = 256 Bytes using this API. It internally calls XMC_FLASH_Er
 224:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * times starting from the first page of the sector.. Call XMC_FLASH_GetStatus() API after calling 
 225:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * to verify the erase operation.\n
 226:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * \endif
 227:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  *
 228:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * \if XMC4
 229:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * Erases a sector associated with the specified \a address.\n\n  Before erase, it clears the error
 230:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * FSR status register. Issues the erase sector command sequence with the specified starting \a add
 231:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * erase process. Call XMC_FLASH_GetStatus() API after calling this API, to verify the erase operat
 232:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * \endif
 233:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * \if XMC1
 234:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * \par<b>Related APIs:</b><BR>
 235:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * XMC_FLASH_ErasePages() \n\n\n
 236:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * \endif
 237:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * \if XMC4
 238:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * \par<b>Related APIs:</b><BR>
 239:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * None
 240:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  * \endif
 241:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h ****  */
 242:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h **** void XMC_FLASH_EraseSector(uint32_t *address);
 243:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_flash.h **** 
