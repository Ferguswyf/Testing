3454:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h **** /**
3455:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  * @param group_ptr     Constant pointer to the VADC group
3456:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  * @return
3457:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  *    uint32_t returns the total number of channels.
3458:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  *             <BR>Range: [0x0 to 0x8]
3459:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  *
3460:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  * \par<b>Description:</b><br>
3461:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  * Returns the number of channels present in the queue.<BR>\n
3462:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  * This API will return the queue buffer size. This buffer will be consisting of valid queue entrie
3463:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  * will be converted when a trigger event occurs. All the entries that are loaded onto the GxQINR0 
3464:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  * be added to the queue buffer. Hence if an application needs to get the number of valid queue ent
3465:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  * this API would provide the interface. A call to this API would access the registers GxQBUR0, GxQ
3466:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  * to determine the queue length.
3467:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  *
3468:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  * \par<b>Related APIs:</b><br>
3469:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  *  XMC_VADC_GROUP_QueueInsertChannel()<BR>
3470:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  */
3471:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h **** uint32_t XMC_VADC_GROUP_QueueGetLength(XMC_VADC_GROUP_t *const group_ptr);
3472:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h **** 
3473:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h **** /**
3474:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  * @param group_ptr     Constant pointer to the VADC group
3475:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  * @return
3476:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  *    None
3477:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  *
3478:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  * \par<b>Description:</b><br>
3479:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  * Aborts an ongoing conversion by flushing the queue.<BR>\n
3480:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  * This API will flush the queue buffer. Ongoing conversion of the Queue request source will
3481:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  * not be effected by this API. This would clear all the contents that are present in the queue buf
3482:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  * A call to this API would configure the registers GxQCTRL0, GxQMR0, GxARBPR in order to abort
3483:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  * the queue sequence.
3484:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  *
3485:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  * \par<b>Related APIs:</b><br>
3486:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  *  XMC_VADC_GROUP_QueueRemoveChannel()<BR> XMC_VADC_GROUP_QueueFlushEntries() <BR>
3487:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  */
3488:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h **** void XMC_VADC_GROUP_QueueAbortSequence(XMC_VADC_GROUP_t *const group_ptr);
3489:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h **** 
3490:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h **** /**
3491:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  * @param group_ptr     Constant pointer to the VADC group
3492:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  * @return
3493:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  *    None
3494:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  *
3495:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  * \par<b>Description:</b><br>
3496:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  * Flushing the queue Entry.<BR>\n
3497:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  * This API will flush one entry in the queue buffer. Ongoing conversion of the Queue request sourc
3498:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  * not be effected by this API. This would clear all the contents that are present in the queue buf
3499:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  * A call to this API would configure the registers  GxQMR0. This is a Blocking API, i.e will only 
3500:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  * all the entries are removed from the queue.
3501:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  *
3502:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_vadc.h ****  * \par<b>Related APIs:</b><br>
