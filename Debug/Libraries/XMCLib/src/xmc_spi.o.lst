1609:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****   return ((uint32_t)(channel->TRBSR & USIC_CH_TRBSR_RBFLVL_Msk) >> USIC_CH_TRBSR_RBFLVL_Pos);
1610:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h **** }
