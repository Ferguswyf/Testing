1656:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****  */
1657:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h **** __STATIC_INLINE void XMC_USIC_CH_RXFIFO_ClearEvent(XMC_USIC_CH_t *const channel,
1658:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****                                                    const uint32_t event)
1659:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h **** {
1660:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****   channel->TRBSCR |= event;
1661:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h **** }
