 409:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  */
 410:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h **** void XMC_SPI_CH_EnableSlaveSelect(XMC_USIC_CH_t *const channel, const XMC_SPI_CH_SLAVE_SELECT_t sla
 411:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h **** 
 412:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h **** /**
 413:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * @param channel A constant ponter to XMC_USIC_CH_t, pointing to the USIC channel base address.
 414:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  *
 415:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * @return None
 416:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  *
