 311:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h **** /**
 312:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * @param channel A constant pointer to XMC_USIC_CH_t, pointing to the USIC channel base address.
 313:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * @param config pointer to constant SPI channel configuration data structure.\n
 314:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  *               Refer data structure @ref XMC_SPI_CH_CONFIG_t for detail.
 315:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  *
 316:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * @return None
 317:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  *
 318:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * \par<b>Description:</b><br>
 319:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * Initializes the selected SPI \a channel with the \a config structure.\n\n
 320:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * Enable SPI channel by calling XMC_USIC_CH_Enable() and then configures
 321:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * <ul>
 322:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * <li>Baudrate,</li>
 323:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * <li>Passive data level as active high,</li>
 324:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * <li>Shift control signal as active high,</li>
 325:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * <li>Frame length as 64U,</li>
 326:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * <li>Word length as 8U,</li>
 327:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * <li>Enable Hardware port control mode,</li>
 328:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * <li>Enable transmission of data TDV(Transmit data valid) bit is set to 1,</li>
 329:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * <li>Enable invalidation of data in TBUF once loaded into shift register,</li>
 330:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * <li>Parity mode settings</li>
 331:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * </ul>
 332:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * And if master mode is selected,
 333:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * <ul>
 334:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * <li>Enables MSLS signal generation,</li>
 335:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * <li>configures slave selection as normal mode,</li>
 336:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * <li>Set polarity for the Slave signal,</li>
 337:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * <li>Enable Frame end mode(MSLS signal is kept active after transmission of a frame)</li>
 338:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * </ul>
 339:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  */
 340:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h **** void XMC_SPI_CH_Init(XMC_USIC_CH_t *const channel, const XMC_SPI_CH_CONFIG_t *const config);
 341:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h **** 
 342:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h **** /**
 343:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * @param channel A constant pointer to XMC_USIC_CH_t, pointing to the USIC channel base address.
 344:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  *
 345:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * @return None
 346:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  *
 347:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * \par<b>Description:</b><br>
 348:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * Set the selected USIC channel to operate in SPI mode, by setting CCR.MODE bits.\n\n
 349:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * It should be executed after XMC_SPI_CH_Init() during initialization. By invoking XMC_SPI_CH_Stop
 350:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * to IDLE state. Call XMC_SPI_CH_Start() to set the SPI mode again, as needed later in the program
 351:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  *
 352:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * \par<b>Related APIs:</b><BR>
 353:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * XMC_SPI_CH_Init(), XMC_SPI_CH_Stop()
 354:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  */
 355:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h **** __STATIC_INLINE void XMC_SPI_CH_Start(XMC_USIC_CH_t *const channel)
 356:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h **** {
 357:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****   /* USIC channel in SPI mode */
 358:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****   XMC_USIC_CH_SetMode(channel, XMC_USIC_CH_OPERATING_MODE_SPI);
 359:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h **** }
 360:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h **** 
 361:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h **** /**
 362:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * @param channel A constant pointer to XMC_USIC_CH_t, pointing to the USIC channel base address.
 363:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  *
 364:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * @return XMC_SPI_CH_STATUS_t Status of the SPI driver after the request for stopping is processed
 365:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  *        XMC_SPI_CH_STATUS_OK- If the USIC channel is successfully put to IDLE mode. \n
 366:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  *        XMC_SPI_CH_STATUS_BUSY- If the USIC channel is busy transmitting data.
 367:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  *
 368:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * \par<b>Description:</b><br>
 369:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * Set the selected SPI channel to IDLE mode, by clearing CCR.MODE bits.\n\n
 370:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * After calling XMC_SPI_CH_Stop, channel is IDLE mode. So no communication is supported. XMC_SPI_C
 371:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * invoked to start the communication again.
 372:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  *
 373:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * \par<b>Related APIs:</b><BR>
 374:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * XMC_SPI_CH_Start()
 375:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  */
 376:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h **** XMC_SPI_CH_STATUS_t XMC_SPI_CH_Stop(XMC_USIC_CH_t *const channel);
 377:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h **** 
 378:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h **** /**
 379:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * @param channel A constant pointer to XMC_USIC_CH_t, pointing to the USIC channel base address.
 380:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * @param rate Bus speed in bits per second
 381:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  *
 382:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * @return XMC_SPI_CH_STATUS_t Status of the SPI driver after the request for setting baudrate is p
 383:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  *        XMC_SPI_CH_STATUS_OK- If the baudrate is successfully changed. \n
 384:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  *        XMC_SPI_CH_STATUS_ERROR- If the new baudrate value is out of range.
 385:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  *
 386:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * \par<b>Description:</b><br>
 387:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  * Sets the bus speed in bits per second
 388:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_spi.h ****  *
