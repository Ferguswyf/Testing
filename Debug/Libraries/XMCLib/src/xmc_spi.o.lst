1471:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****  *
1472:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****  * \par<b>Description</b><br>
1473:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****  * Disables the selected interrupt events related to receive FIFO. \n\n
1474:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****  * By disabling the interrupt events, generation of interrupt is stopped. User can poll the event 
1475:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****  * flags from the status register using the API XMC_USIC_CH_RXFIFO_GetEvent(). 
1476:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****  * Event bitmasks can be constructed using the enumeration \a XMC_USIC_CH_RXFIFO_EVENT_CONF. For pr
1477:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****  * multiple events, combine the events using bitwise OR operation.
1478:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****  *
1479:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****  * \par<b>Related APIs:</b><BR>
1480:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****  * XMC_USIC_CH_RXFIFO_GetEvent(), XMC_USIC_CH_RXFIFO_EnableEvent() \n\n\n
1481:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****  */
1482:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h **** __STATIC_INLINE void XMC_USIC_CH_RXFIFO_DisableEvent(XMC_USIC_CH_t *const channel, const uint32_t e
1483:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h **** {
1484:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****   channel->RBCTR &= (uint32_t)~event;
