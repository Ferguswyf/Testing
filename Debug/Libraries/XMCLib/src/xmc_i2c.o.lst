  62:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_i2c.h ****  * @addtogroup XMClib XMC Peripheral Library
  63:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_i2c.h ****  * @{
  64:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_i2c.h ****  */
  65:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_i2c.h **** 
  66:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_i2c.h **** /**
  67:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_i2c.h ****  * @addtogroup I2C
  68:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_i2c.h ****  * @brief Inter Integrated Circuit(IIC) driver for the XMC microcontroller family. 
  69:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_i2c.h ****  *
  70:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_i2c.h ****  * USIC IIC Features: <br>
  71:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_i2c.h ****  *  * Two-wire interface, with one line for shift clock transfer and synchronization (shift clock S
  72:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_i2c.h ****  *	* Communication in standard mode (100 kBit/s) or in fast mode (up to 400 kBit/s) <br>
  73:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_i2c.h ****  *	* Support of 7-bit addressing, as well as 10-bit addressing <br>
  74:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_i2c.h ****  *	* Master mode operation, where the IIC controls the bus transactions and provides the clock sign
  75:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_i2c.h ****  *	* Slave mode operation, where an external master controls the bus transactions and provides the 
  76:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_i2c.h ****  *	* Multi-master mode operation, where several masters can be connected to the bus and bus arbitra
  77:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_i2c.h **** 	  The master/slave operation of an IIC bus participant can change from frame to frame. <br>
  78:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_i2c.h ****  *	* Efficient frame handling (low software effort), also allowing DMA transfers <br>
  79:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_i2c.h ****  *	* Powerful interrupt handling due to multitude of indication flags <br>
  80:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_i2c.h ****  * @{
  81:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_i2c.h ****  */
  82:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_i2c.h **** 
  83:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_i2c.h **** /*******************************************************************************
  84:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_i2c.h ****  * MACROS
  85:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_i2c.h ****  *******************************************************************************/
  86:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_i2c.h **** 
  87:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_i2c.h **** #if defined(USIC0)
  88:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_i2c.h **** #define XMC_I2C0_CH0 XMC_USIC0_CH0                   /**< USIC0 channel 0 base address */
