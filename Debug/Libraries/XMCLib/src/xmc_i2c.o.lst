1619:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****  * \par<b>Description</b><br>
1620:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****  * Gets the receive FIFO events' status. \n\n
1621:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****  * Gives the status of receive FIFO standard receive buffer event, alternative receive buffer event
1622:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****  * The status bits are located at their bitpositions in the TRBSR register in the returned value.
1623:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****  * User can make use of the XMC_USIC_CH_RXFIFO_EVENT enumeration for checking the status of return 
1624:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****  * The status can be found by using the bitwise AND operation on the returned value with the enumer
1625:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****  * 
1626:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****  * Note: Event status flags should be cleared by the user explicitly.
1627:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****  *
1628:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****  * \par<b>Related APIs:</b><BR>
1629:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****  * XMC_USIC_CH_RXFIFO_ClearEvent()\n\n\n
1630:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****  */
1631:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h **** __STATIC_INLINE uint32_t XMC_USIC_CH_RXFIFO_GetEvent(XMC_USIC_CH_t *const channel)
1632:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h **** {
1633:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****   return (uint32_t)((channel->TRBSR) & (USIC_CH_TRBSR_SRBI_Msk |
1634:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****                               USIC_CH_TRBSR_RBERI_Msk |
1635:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h ****                               USIC_CH_TRBSR_ARBI_Msk));
1636:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_usic.h **** }
