  58:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * @addtogroup XMClib XMC Peripheral Library
  59:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * @{
