1572:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * \par<b>Description:</b><br>
1573:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * Enables dithering of PWM frequency and duty cycle, by configuring CC4yTC.DITHE and CC4yDITS bits
1574:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * Some control loops are slow in updating PWM frequency and duty cycle. In such a case, a Bresenha
1575:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * can help reduce long term errors. Dithering can be applied to period and duty individually,
1576:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * this can be selected using the parameter \b period_dither and \b duty_dither.
1577:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * The \b spread would provide the dither compare value. If the dither counter value is less than t
1578:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * the period/compare values would be dithered according to the dither mode selected. This API woul
1579:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * XMC_CCU4_SLICE_SetDitherCompareValue().
1580:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  *
1581:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * \par<b>Note:</b><br>
1582:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * After this API call, XMC_CCU4_EnableShadowTransfer() has to be called with appropriate mask
1583:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * to transfer the dither value.
1584:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  *
1585:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * \par<b>Related APIs:</b><br>
1586:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  *  XMC_CCU4_SLICE_DisableDithering().
1587:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  */
1588:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h **** void XMC_CCU4_SLICE_EnableDithering(XMC_CCU4_SLICE_t *const slice,
1589:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****                                     const bool period_dither,
1590:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****                                     const bool duty_dither,
1591:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****                                     const uint8_t spread);
1592:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h **** 
1593:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h **** /**
1594:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * @param slice Constant pointer to CC4 Slice
1595:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * @return <BR>
1596:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  *    None<BR>
1597:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  *
1598:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * \par<b>Description:</b><br>
1599:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * Disables dithering of PWM frequency and duty cycle, by clearing CC4yTC.DITHE bits.\n\n
1600:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * This disables the Dither mode that was set in XMC_CCU4_SLICE_EnableDithering().
1601:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * This API will not clear the dither compare value.
1602:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  *
1603:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * \par<b>Related APIs:</b><br>
1604:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  *  XMC_CCU4_SLICE_EnableDithering().
1605:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  */
1606:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h **** __STATIC_INLINE void XMC_CCU4_SLICE_DisableDithering(XMC_CCU4_SLICE_t *const slice)
1607:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h **** {
1608:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****   XMC_ASSERT("XMC_CCU4_SLICE_DisableDithering:Invalid Slice Pointer", XMC_CCU4_CHECK_SLICE_PTR(slic
1609:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****   slice->TC &= ~((uint32_t) CCU4_CC4_TC_DITHE_Msk);
1610:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h **** }
1611:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h **** 
1612:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h **** /**
1613:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * @param slice Constant pointer to CC4 Slice
1614:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * @return <BR>
1615:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  *    None<BR>
1616:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  *
1617:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * \par<b>Description:</b><br>
1618:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * Enables the floating prescaler, by setting CC4yTC.FPE bit.\n\n
1619:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * The prescaler divider starts with an initial value and increments upon every period match. It ke
1620:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * until a ceiling (prescaler compare value) is hit and thereafter rolls back to the original presc
1621:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * It is necessary to have programmed an initial divider value and a compare value before the featu
1622:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  *
1623:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * \par<b>Related APIs:</b><br>
1624:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  *  XMC_CCU4_SLICE_SetFloatingPrescalerCompareValue()<BR> XMC_CCU4_SLICE_DisableFloatingPrescaler()
1625:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  *  XMC_CCU4_SLICE_SetPrescaler().
1626:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  */
1627:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h **** __STATIC_INLINE void XMC_CCU4_SLICE_EnableFloatingPrescaler(XMC_CCU4_SLICE_t *const slice)
1628:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h **** {
1629:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****   XMC_ASSERT("XMC_CCU4_SLICE_EnableFloatingPrescaler:Invalid Slice Pointer", XMC_CCU4_CHECK_SLICE_P
1630:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****   slice->TC |= (uint32_t) CCU4_CC4_TC_FPE_Msk;
1631:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h **** }
1632:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h **** 
1633:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h **** /**
1634:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * @param slice Constant pointer to CC4 Slice
1635:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * @return <BR>
1636:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  *    None<BR>
1637:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  *
1638:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * \par<b>Description:</b><br>
1639:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * Disables the floating prescaler, by clearing CC4yTC.FPE bit.\n\n
1640:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * This would return the prescaler to the normal mode.
1641:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * The prescaler that would be applied is the value present in CC4yPSC.
1642:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  *
1643:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****   * \par<b>Related APIs:</b><br>
1644:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  *  XMC_CCU4_SLICE_EnableFloatingPrescaler().
1645:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  */
1646:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h **** __STATIC_INLINE void XMC_CCU4_SLICE_DisableFloatingPrescaler(XMC_CCU4_SLICE_t *const slice)
1647:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h **** {
1648:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****   XMC_ASSERT("XMC_CCU4_SLICE_DisableFloatingPrescaler:Invalid Slice Pointer", XMC_CCU4_CHECK_SLICE_
1649:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****   slice->TC &= ~((uint32_t) CCU4_CC4_TC_FPE_Msk);
1650:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h **** }
1651:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h **** 
1652:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h **** /**
1653:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * @param slice Constant pointer to CC4 Slice
1654:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * @param comp_val Dither compare value
1655:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  *                 Range: [0x0 to 0xF]
1656:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * @return <BR>
1657:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  *    None<BR>
1658:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  *
1659:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * \par<b>Description:</b><br>
1660:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * Sets the dither spread/compare value, by setting CC4yDITS.DCVS bits.\n\n
1661:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * This value is the cornerstone of PWM dithering feature. Dithering is applied/done when the value
1662:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * dithering counter is less than this compare/spread value. For all dithering counter values great
1663:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * the spread value, there is no dithering. After setting the value XMC_CCU4_EnableShadowTransfer()
1664:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  * called with appropriate mask.
1665:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  *
1666:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****   * \par<b>Related APIs:</b><br>
1667:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  *  XMC_CCU4_SLICE_EnableDithering().
1668:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h ****  */
1669:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h **** __STATIC_INLINE void XMC_CCU4_SLICE_SetDitherCompareValue(XMC_CCU4_SLICE_t *const slice, const uint
1670:D:/SoftWar_Debug/XMC1300_GPIO/Libraries/XMCLib/inc\xmc_ccu4.h **** {
